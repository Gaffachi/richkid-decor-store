# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — never commit real secrets.

# ── Firebase client config (safe to expose to the browser) ──────────────────
# Firebase Console > Project Settings > General > Your apps > Web app > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server-only, NEVER expose to the browser) ───────────
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key. If pasted as a single line, keep the \n escape
# sequences literal — lib/firebase/admin.ts converts them back to newlines.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ── Cloudinary (unsigned upload widget — safe to expose to the browser) ─────
# cloudinary.com dashboard > Cloud name; Settings > Upload > Upload presets
# (create one with Signing Mode = Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── WhatsApp checkout ─────────────────────────────────────────────────────
# International format, digits only, no "+" or spaces (e.g. 233241234567 for
# a Ghana number starting 024). Orders are sent here as a pre-filled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Site URL (used by sitemap.xml, robots.txt, canonical tags, OG image URLs) ──
NEXT_PUBLIC_SITE_URL=
